FROM python:3.11-slim

WORKDIR /app

# Set Python path to include backend directory
ENV PYTHONPATH=/app/backend

# Stream stdout/stderr straight to the container log instead of buffering it,
# so sync daemon progress and errors are visible in `docker logs`.
ENV PYTHONUNBUFFERED=1

# Create a non-root user
RUN adduser --disabled-password --gecos '' appuser

# Install dependencies. The pip/setuptools shipped in the base image carry
# their own advisories, so upgrade the build tooling before resolving deps.
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools \
    && pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ ./backend/

# Set ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port (Backend runs on 5001 usually in this project)
EXPOSE 5001

# Default command (can be overridden by docker-compose).
# --workers is deliberately absent: gunicorn reads the worker count from the
# WEB_CONCURRENCY environment variable when the flag is not passed, so an
# operator can resize the pool through compose without rebuilding the image.
# Note that gunicorn's own fallback is 1 worker if WEB_CONCURRENCY is unset —
# the default supplied in docker-compose.yml is therefore load-bearing, not
# decorative.
CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--threads", "2", "app:app"]
