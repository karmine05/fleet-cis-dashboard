FLEET_URL=<url>
FLEET_API_TOKEN=<fleet_token>

# TLS verify when calling Fleet (default: true). Set false only for self-signed lab certs.
FLEET_SSL_VERIFY=true

# Required to save Settings (PUT /api/config). Generate a long random string.
DASHBOARD_API_TOKEN=<random_write_token>

# Optional
# SYNC_INTERVAL_MINUTES=15
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082