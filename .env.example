# Fleet CIS Dashboard — environment template
#
# Copy to .env and fill in the REQUIRED block. .env is gitignored; never commit it.
#   cp .env.example .env
#
# Everything outside the REQUIRED block is optional tuning: each line shows the
# default that applies when the variable is absent, so an empty .env (plus the
# required values) is a working configuration. Commented-out lines are the
# defaults — uncomment only what you actually want to change.
#
# Bad values do not crash anything: every numeric tunable read by this project's
# own code falls back to its documented default and logs a warning rather than
# raising at start-up. The one exception is WEB_CONCURRENCY, which gunicorn parses
# itself with a bare int() before any of this project's code runs — a typo there
# does stop the backend from starting. See its entry below.


# =============================================================================
# REQUIRED — the stack will not work without these
# =============================================================================

# Base URL of your Fleet server, no trailing slash. Read by the sync daemon.
FLEET_URL=https://fleet.example.com

# Fleet API token used to read hosts, policies and teams. Create one in Fleet
# under My account -> Get API token. Treat it as a credential: it can read your
# whole fleet inventory.
FLEET_API_TOKEN=

# Postgres password. There is deliberately NO default — docker compose refuses to
# start until this is set, so no deployment can come up with a password that is
# published in this repository. Generate one:
#   openssl rand -hex 32
#
# Use only [A-Za-z0-9._~-] (hex output qualifies) and you can stop reading. The
# value is interpolated into a postgresql:// URL, and these were measured against
# that exact DSN:
#   $  do NOT use. docker compose expands it as a variable before the database or
#      the app ever sees it, so POSTGRES_PASSWORD=pa$ss silently becomes "pa".
#      initdb and the clients then agree on a password you did not choose, and
#      nothing appears broken. Write $$ if you must include one.
#   %  rejected: "invalid percent-encoded token"
#   /  rejected: everything after it is parsed as the port
#   @ : ? #  work here, though they read like they should not
#
# Note this is consumed only when the database volume is FIRST initialised.
# Changing it later does not change an existing cluster's password — it just makes
# the backend and sync send one the database rejects. To rotate on a live volume,
# ALTER USER inside the db container first, then update this value.
POSTGRES_PASSWORD=

# REQUIRED ONLY IF you want the dashboard's Settings page to save changes.
# Bearer token for PUT /api/config. While unset, that endpoint fails closed with
# 503 and the rest of the dashboard stays fully readable. Generate as above.
DASHBOARD_API_TOKEN=


# =============================================================================
# Fleet connection
# =============================================================================

# Verify Fleet's TLS certificate. Default: true. Set false ONLY for a lab server
# with a self-signed certificate — it disables certificate checking entirely.
# FLEET_SSL_VERIFY=true


# =============================================================================
# Database
# =============================================================================

# Postgres role and database name. Defaults: postgres / fleet_cis.
# Both are baked into the postgres_data volume the first time it initialises;
# changing them later does not rename anything in an existing volume.
# POSTGRES_USER=postgres
# POSTGRES_DB=fleet_cis

# Full connection string. Under docker compose this is BUILT from the three
# POSTGRES_* variables above and setting it here has no effect — compose always
# overrides it so the backend, sync and db services cannot drift apart. Set it
# only when running the app directly on a host, outside compose.
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/fleet_cis

# Per-process connection pool bounds. Defaults: 1 and 8. Each gunicorn worker and
# the sync daemon each hold their own pool, so the ceiling that matters is
# WEB_CONCURRENCY x DB_POOL_MAX + DB_POOL_MAX < the db's max_connections (200).
# Defaults use 40 of 200. Only 2 connections per worker are usable concurrently
# (gunicorn runs 2 threads per worker), so raising DB_POOL_MAX mostly buys idle
# sockets.
# DB_POOL_MIN=1
# DB_POOL_MAX=8

# After the pool's connect retries (5 attempts, 2s apart) are exhausted, remember
# the failure for this many seconds so requests fail fast instead of each one
# blocking a worker thread for the full retry budget while Postgres is down.
# Default: 10.
# DB_POOL_RETRY_COOLDOWN_SECONDS=10


# =============================================================================
# Web + security
# =============================================================================

# Comma-separated browser origins allowed to call the API cross-origin.
# Default under compose: http://localhost:8081,http://localhost:8082
# (the app's own built-in default, used outside compose, is http://localhost:8081).
# Requests that reach the API through nginx are same-origin and never consult it.
# ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082

# Legacy single-origin fallback for ALLOWED_ORIGINS, consulted only when
# ALLOWED_ORIGINS is absent from the process environment. Under docker compose
# ALLOWED_ORIGINS always has a value, so this has no effect there — set
# ALLOWED_ORIGINS instead. Kept for non-compose runs. Default: unset.
# FRONTEND_URL=http://localhost:8081

# gunicorn worker count, read natively by gunicorn. Default: 4 (supplied by
# docker-compose.yml — gunicorn's own fallback is 1, so that default is
# load-bearing). See the DB_POOL_MAX arithmetic above before raising it: workers
# multiply database connections.
#
# This is the ONE tunable that is not parsed leniently. gunicorn evaluates it with
# int() at config-import time, so a non-numeric value raises before any of this
# project's code runs: the backend exits and, with restart: unless-stopped, keeps
# restarting. Verified against the installed gunicorn. Set it to a plain integer.
# WEB_CONCURRENCY=4

# Ceiling that the /api/devices `limit` parameter is clamped to. Default: 500.
# MAX_PAGE_SIZE=500

# Port for the Flask development server only (python backend/app.py).
# Default: 5001. Ignored in every container: gunicorn binds the port itself via
# Dockerfile.backend, and compose maps host 5002 -> container 5001.
# PORT=5001


# =============================================================================
# Sync behaviour
# =============================================================================

# Minutes between syncs. Default under compose: 15 (the app's own built-in
# default, used outside compose, is 5). A full sync of 32 hosts / 789 policies
# takes about 1.6s, so the interval is about how fresh you want the data, not
# about how long a sync takes.
# SYNC_INTERVAL_MINUTES=15

# Threads used for concurrent Fleet API calls. Default: 10. Fleet is the
# bottleneck, not this container, so raising it mainly adds load to Fleet.
# SYNC_MAX_WORKERS=10

# Page sizes for the two paginated Fleet reads. Defaults: 100 and 500.
# The per-policy host lists use a larger page because one policy can cover the
# whole fleet and every extra page is another round trip.
# SYNC_HOSTS_PER_PAGE=100
# SYNC_POLICY_HOSTS_PER_PAGE=500

# Rotating full-refresh sweep. Fleet's cached passing/failing host counts are not
# a reliable change signal — measured here, 39 of 789 policies had counts that
# disagreed with Fleet's own live host lists, and count-preserving churn (one host
# passes while another fails) is invisible to them. So each sync force-re-enumerates
# 1/N of the catalog, and every policy is fully refreshed within N syncs:
# 24 syncs is 6 hours at the 15-minute cadence. Default: 24.
# Set 0 to disable the sweep, or 1 to re-enumerate every policy on every sync
# (much more load on Fleet).
# SYNC_FULL_REFRESH_DIVISOR=24

# File whose mtime the daemon refreshes each loop; the container healthcheck reads
# it to decide liveness. Default: /tmp/sync_heartbeat. Any other path must be
# writable by appuser, since the image drops root.
# SYNC_HEARTBEAT_FILE=/tmp/sync_heartbeat

# Seconds a single sync cycle may run before the daemon considers itself wedged,
# logs loudly and exits with code 75 so the restart policy recovers it. Docker
# never restarts a container just because its healthcheck fails, so this is what
# turns "detected as unhealthy" into "actually recovered".
# Default: max(300, 3 x SYNC_INTERVAL_MINUTES x 60) — 2700s at the 15-minute
# cadence, against a sync that normally finishes in about 1.6s. An explicit value
# below 30 is raised to 30 with a warning; 0 disables the watchdog.
# SYNC_WATCHDOG_TIMEOUT_SECONDS=


# =============================================================================
# Retention + history
# =============================================================================

# Whole months of policy_results_history to keep. Older monthly partitions are
# DROPped, which is far cheaper than deleting rows. Default: 12. 0 disables
# retention and keeps history forever.
# HISTORY_RETENTION_MONTHS=12

# Rows stranded in the DEFAULT history partition cannot be reclaimed by dropping a
# partition, so they are swept row-wise, at most this many per sync. Bounded on
# purpose: an unbounded DELETE would hold locks on a table the dashboard reads.
# Default: 50000.
# HISTORY_DEFAULT_SWEEP_LIMIT=50000

# Age at which sync_metadata rows are pruned. The 20 most recent rows are always
# kept, so /api/sync-status still reports on a long-idle instance. Default: 90.
# 0 disables pruning.
# SYNC_METADATA_RETENTION_DAYS=90

# Look-back window in days for the history-backed trend deltas. Default: 30.
# HISTORY_TREND_DAYS=30

# Minimum number of paired samples in that window before a trend is reported at
# all, rather than showing a delta computed from too little data. Default: 5.
# HISTORY_TREND_MIN_SAMPLE=5


# =============================================================================
# Cache (Redis — entirely optional)
# =============================================================================

# Redis connection for the response cache. Default under compose:
# redis://redis:6379/0. Set it empty to run without a cache: the app then serves
# live results and warns once, it does not fail. Measured effect on a cached
# endpoint: 34ms cold vs 6ms warm.
# REDIS_URL=redis://redis:6379/0

# Memory ceiling passed to the redis container (compose only, not read by the
# app). Default: 256mb, with allkeys-lru eviction so a full cache evicts the
# coldest entry instead of erroring.
# REDIS_MAXMEMORY=256mb

# Cache TTL in seconds. Default: 900. Entries also retire automatically on every
# successful sync, because the cache key embeds the sync generation.
# CACHE_TTL_SECONDS=900

# After a transient Redis failure, serve uncached for this many seconds before
# re-probing. Default: 30. Stops one blip from disabling the cache for the rest of
# the worker's life.
# CACHE_RETRY_COOLDOWN_SECONDS=30

# Redis socket timeout in milliseconds. Default: 500. Deliberately sub-second: a
# wedged Redis must never add more latency than the query it stands in for.
# REDIS_TIMEOUT_MS=500


# =============================================================================
# Logging
# =============================================================================

# Optional rotating file log. Default: unset, meaning logs go to stdout only,
# where `docker compose logs` can see them and the json-file driver rotates them.
# Set a path only if you also want a file inside the container; it must be
# writable by appuser, e.g. /tmp/fleetcis.log. Note that all gunicorn workers
# share the path while rotating independently, so the file log is a convenience
# for single-process runs rather than the primary sink.
# LOG_FILE=

# Rotation bounds for that file log, ignored while LOG_FILE is unset.
# Defaults: 10485760 (10 MB) per file, 3 old files kept.
# LOG_MAX_BYTES=10485760
# LOG_BACKUP_COUNT=3
